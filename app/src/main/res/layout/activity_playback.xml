<?xml version="1.0" encoding="utf-8"?>
<!-- 全屏播放：PlayerView 自带控制条 + 自定义控制层（左上返回 / 右上投屏 / 右下设置）。
     自定义层的显隐由 PlaybackActivity 自主管控（关闭 media3 自动显隐，统一 4000ms 定时器），
     与 media3 控制条严格同显同隐，触屏 / 遥控器再次唤起都能一起出现。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="true"
        app:controller_layout_id="@layout/playback_controller"
        app:resize_mode="fit" />

    <!-- 与 PlayerView 控制器同显隐的控制层 -->
    <FrameLayout
        android:id="@+id/control_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:descendantFocusability="afterDescendants"
        android:focusable="false">

        <Button
            android:id="@+id/btn_back_top"
            style="@style/TvChip"
            android:background="@drawable/bg_overlay_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="@dimen/overscan_h"
            android:layout_marginTop="@dimen/overscan_v"
            android:minWidth="90dp"
            android:nextFocusDown="@+id/player_view"
            android:nextFocusRight="@+id/btn_settings"
            android:drawableStart="@drawable/ic_arrow_back"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:text="@string/action_back"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/play_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="150dp"
            android:layout_marginTop="@dimen/overscan_v"
            android:background="#99000000"
            android:ellipsize="end"
            android:maxLines="1"
            android:padding="8dp"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body" />

        <Button
            android:id="@+id/btn_cast"
            style="@style/TvChip"
            android:background="@drawable/bg_overlay_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginEnd="@dimen/overscan_h"
            android:layout_marginTop="@dimen/overscan_v"
            android:minWidth="90dp"
            android:nextFocusLeft="@id/btn_back_top"
            android:nextFocusDown="@+id/btn_settings"
            android:text="@string/action_cast"
            android:textAllCaps="false" />

        <!-- 右上角设置菜单入口（手机 / TV 统一置于右上角，与左上角返回呼应） -->
        <Button
            android:id="@+id/btn_settings"
            style="@style/TvChip"
            android:background="@drawable/bg_overlay_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginEnd="@dimen/overscan_h"
            android:layout_marginTop="@dimen/overscan_v"
            android:minWidth="100dp"
            android:nextFocusLeft="@id/btn_back_top"
            android:nextFocusUp="@id/btn_back_top"
            android:nextFocusDown="@+id/player_view"
            android:drawableStart="@drawable/ic_settings"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:text="@string/action_settings"
            android:textAllCaps="false" />
    </FrameLayout>

    <!-- 右下角设置面板：倍速播放 + 投屏入口 -->
    <LinearLayout
        android:id="@+id/settings_panel"
        android:layout_width="440dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/overscan_h"
        android:layout_marginBottom="@dimen/overscan_v"
        android:background="@color/bg_elevated"
        android:clickable="true"
        android:descendantFocusability="afterDescendants"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="播放设置"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/speed_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="倍速播放（当前 1.0x）"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_small" />

        <LinearLayout
            android:id="@+id/speed_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />

        <Button
            android:id="@+id/btn_settings_cast"
            style="@style/TvChip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/action_cast"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_settings_close"
            style="@style/TvChip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="关闭"
            android:textAllCaps="false" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/error_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/bg_elevated"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/error_text"
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_card" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_retry"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:nextFocusRight="@+id/btn_back"
                android:text="@string/action_retry"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_back"
                style="@style/TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:nextFocusLeft="@id/btn_retry"
                android:text="返回换源"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- 投屏设备面板 -->
    <LinearLayout
        android:id="@+id/cast_panel"
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/bg_elevated"
        android:clickable="true"
        android:descendantFocusability="afterDescendants"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="投屏到设备（DLNA / UPnP）"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cast_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:maxLines="4"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_small" />

        <LinearLayout
            android:id="@+id/cast_devices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <!-- 手机端投屏成功后出现：本机播放已停止，点此恢复 -->
        <Button
            android:id="@+id/btn_cast_resume"
            style="@style/TvChip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="本机继续播放"
            android:textAllCaps="false"
            android:visibility="gone" />

        <EditText
            android:id="@+id/cast_manual_url"
            style="@style/TvUrlEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="设备描述地址，如 http://192.168.1.8:8200/rootDesc.xml"
            android:inputType="textUri"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_cast_rescan"
                style="@style/TvChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="重新搜索"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_cast_manual"
                style="@style/TvChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="手动添加"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_cast_add"
                style="@style/TvChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="确定"
                android:textAllCaps="false"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_cast_stop"
                style="@style/TvChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="停止投屏"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_cast_close"
                style="@style/TvChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="关闭"
                android:textAllCaps="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/cast_url_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_tiny" />
    </LinearLayout>
</FrameLayout>
