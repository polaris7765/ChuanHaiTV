<?xml version="1.0" encoding="utf-8"?>
<!-- 双栏首页：左侧窄分类栏（宽度运行时设为屏幕 1/6 的 60%），
     右侧显示当前分类热播剧集或历史记录 / 我的收藏 -->
<com.yujiannatian.tv.ui.FocusRoot xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/overscan_h"
    android:paddingRight="@dimen/overscan_h"
    android:paddingTop="@dimen/overscan_v"
    android:paddingBottom="@dimen/overscan_v">

    <LinearLayout
        android:id="@+id/left_pane"
        android:layout_width="160dp"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/brand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="@string/home_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sidebar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:focusable="false"
            android:scrollbars="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="上下选择 · OK 切换"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_tiny" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/right_pane"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/section_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/row_hot"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/section_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_tiny" />

            <!-- 这些页眉按钮用 focusableInTouchMode=false：手机 / 触屏电视上
                 一次点击就直接触发，不会像默认 TvButton 那样第一次只聚焦不点击。 -->
            <Button
                android:id="@+id/btn_prev"
                style="@style/TvChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusableInTouchMode="false"
                android:nextFocusRight="@+id/btn_next"
                android:drawableStart="@drawable/ic_chevron_left"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:text="@string/action_prev_page"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_next"
                style="@style/TvChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:focusableInTouchMode="false"
                android:nextFocusLeft="@id/btn_prev"
                android:nextFocusRight="@+id/btn_refresh"
                android:drawableStart="@drawable/ic_chevron_right"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:text="@string/action_next_page"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_refresh"
                style="@style/TvChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:focusableInTouchMode="false"
                android:nextFocusLeft="@id/btn_next"
                android:nextFocusRight="@+id/btn_clear"
                android:drawableStart="@drawable/ic_refresh"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:text="@string/action_refresh"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_clear"
                style="@style/TvChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:focusableInTouchMode="false"
                android:nextFocusLeft="@id/btn_refresh"
                android:text="@string/action_clear"
                android:textAllCaps="false"
                android:visibility="gone" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/video_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:focusable="false" />

        <TextView
            android:id="@+id/grid_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="方向键移动 · 确认键进入详情 · 向左回到分类栏"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_tiny" />
    </LinearLayout>
</com.yujiannatian.tv.ui.FocusRoot>
