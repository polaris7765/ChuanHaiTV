<?xml version="1.0" encoding="utf-8"?>
<!-- 自定义播放控制条：
     · 画面中间只有居中的播放 / 暂停按钮（圆形半透明底）；
     · 画面下方显示进度条 + 当前时间 / 总时长。
     media3 的 PlayerControlView 通过 @id/exo_play_pause、@id/exo_progress、
     @id/exo_position、@id/exo_duration 自动绑定播放状态与进度刷新，无需额外 Kotlin 代码。
     控制器整体仍由 PlaybackActivity 统一控制 4 秒显隐。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- 圆形半透明背景：XML 直接声明的 background 优先级高于 ExoMediaButton 样式里的
         方形 selectableItemBackground，因此这里能覆盖掉原来的方形底。 -->
    <ImageButton
        android:id="@id/exo_play_pause"
        style="@style/ExoMediaButton.Play"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_play_pause"
        android:contentDescription="@string/action_play"
        android:padding="22dp"
        android:scaleType="fitCenter" />

    <!-- 底部进度区：左右留出 TV 过扫描安全边距，避免电视上被裁掉 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_controller_bottom"
        android:clipToPadding="false"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/overscan_h"
        android:paddingEnd="@dimen/overscan_h"
        android:paddingTop="24dp"
        android:paddingBottom="@dimen/overscan_v">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#CC000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="00:00"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  /  "
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#CC000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="00:00"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 用 media3 官方的 progress placeholder：PlayerControlView 会在构造时把它
             原地替换成库自带的 DefaultTimeBar（id=exo_progress，样式与官方控制器一致），
             并自动接管进度 / 缓冲刷新与拖拽 seek。直接手写 DefaultTimeBar + 自定义属性
             在实测中会出现「View 有尺寸却不绘制」的问题，故采用官方方案。 -->
        <View
            android:id="@id/exo_progress_placeholder"
            android:layout_width="match_parent"
            android:layout_height="@dimen/exo_styled_progress_layout_height"
            android:layout_marginTop="2dp"
            android:focusable="false" />
    </LinearLayout>
</FrameLayout>
