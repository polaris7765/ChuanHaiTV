<?xml version="1.0" encoding="utf-8"?>
<!-- 下载按钮背景：底层沿用按钮 selector（保留焦点/按下态），
     上层用 ClipDrawable 按 level(0..10000) 从左向右填充半透明进度色。
     进度层四边各内缩 2dp，配合 DetailFragment 给按钮挂的圆角 outline 裁剪，
     填充色始终落在 8dp 圆角方框内，不会溢出到圆角外。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/bg_button" />

    <item
        android:id="@+id/download_progress_fill"
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <clip
            android:clipOrientation="horizontal"
            android:gravity="start">
            <shape android:shape="rectangle">
                <solid android:color="#9954A0FF" />
                <corners android:radius="6dp" />
            </shape>
        </clip>
    </item>
</layer-list>
